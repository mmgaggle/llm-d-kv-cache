# Dockerfile for io_uring integration testing with vLLM
# This extends the base io_uring development image and adds vLLM
# for running integration tests that require vLLM dependencies.

FROM llmd_s3_backend_iouring-dev:latest

LABEL maintainer="llm-d team"
LABEL description="io_uring development environment with vLLM for integration testing"

# Install vLLM for integration testing
# This is a large package (~5-10 GB) so it's in a separate layer
RUN pip install --no-cache-dir vllm

# Verify installation
RUN python3 -c "import vllm; print(f'vLLM version: {vllm.__version__}')"

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]